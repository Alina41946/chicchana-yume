---
import { Image } from "astro:assets";
import type {
  ImageMetadata,
  MarkdownHeading,
} from "astro";

import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;

  projectType: string;
  year?: number;
  role?: string;

  image?: ImageMetadata;
  imageAlt?: string;
  headings?: MarkdownHeading[];
}

const {
  title,
  description,
  projectType,
  year,
  role,
  image,
  imageAlt = "",
  headings = [],
} = Astro.props;

const tocHeadings = headings.filter(
  (heading) => heading.depth === 2
);

const projectTypeLabel = projectType
  .replace(/-/g, " ")
  .toUpperCase();

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout
  title={`${title}｜Works`}
  description={description}
  image={image}
  type="article"
  noindex={true}
>
  <main class="work-page">

    <!-- ========================================
         HERO
    ========================================= -->
    <section class="work-hero">
      <div class="container">

        <nav
          class="breadcrumb"
          aria-label="麵包屑導覽"
        >
          <ol>
            <li>
              <a href={base}>HOME</a>
            </li>

            <li>
              <span aria-hidden="true">/</span>

              <a href={`${base}works/`}>
                WORKS
              </a>
            </li>

            <li>
              <span aria-hidden="true">/</span>

              <span aria-current="page">
                {title}
              </span>
            </li>
          </ol>
        </nav>

        <div class="work-heading">

          <div class="work-title">

            <p class="work-type">
              {projectTypeLabel}
            </p>

            <h1>
              {title}
            </h1>

            <p class="work-description">
              {description}
            </p>

          </div>

          <dl class="work-meta">

            {
              year && (
                <div>
                  <dt>YEAR</dt>
                  <dd>{year}</dd>
                </div>
              )
            }

            {
              role && (
                <div>
                  <dt>ROLE</dt>
                  <dd>{role}</dd>
                </div>
              )
            }

          </dl>

        </div>

      </div>
    </section>

    <!-- ========================================
         COVER
    ========================================= -->
    {
      image && (
        <section class="work-cover">
          <div class="container">

            <Image
              src={image}
              alt={imageAlt}
              widths={[800, 1200, 1600]}
              sizes="(max-width: 767px) 100vw, 1200px"
              loading="eager"
              fetchpriority="high"
            />

          </div>
        </section>
      )
    }

    <!-- ========================================
         CONTENT
    ========================================= -->
    <section class="work-content">

      <div class="container work-content-inner">

        {
  tocHeadings.length > 0 && (
    <aside class="work-index">

      <!-- Desktop / Tablet -->
      <div class="work-index-desktop">

        <p class="work-index-title">
          CASE STUDY
        </p>

        <nav
          class="work-index-nav"
          aria-label="Case Study 目錄"
        >
          <ol>
            {
              tocHeadings.map((heading, index) => (
                <li>
                  <a href={`#${heading.slug}`}>

                    <span class="work-index-number">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <span class="work-index-text">
                      {heading.text}
                    </span>

                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

      </div>

      <!-- Mobile -->
      <details class="work-index-mobile">

        <summary>
          <span>CASE STUDY</span>

          <span class="work-index-toggle">
            CONTENTS
            <span
              class="work-index-arrow"
              aria-hidden="true"
            >
              ↓
            </span>
          </span>
        </summary>

        <nav
          class="work-index-mobile-nav"
          aria-label="Case Study 目錄"
        >
          <ol>
            {
              tocHeadings.map((heading, index) => (
                <li>
                  <a href={`#${heading.slug}`}>

                    <span class="work-index-number">
                      {String(index + 1).padStart(2, "0")}
                    </span>

                    <span class="work-index-text">
                      {heading.text}
                    </span>

                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

      </details>

    </aside>
  )
}

        <article class="work-article">
          <slot />
        </article>

      </div>

    </section>

    <!-- ========================================
         BACK
    ========================================= -->
    <section class="back-to-works">

      <div class="container">

        <a href={`${base}works/`}>
          <span aria-hidden="true">
            ←
          </span>

          BACK TO WORKS
        </a>

      </div>

    </section>

  </main>
</Layout>

<style>
  /* ========================================
     HERO
  ========================================= */

  .work-hero {
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
  }

  .breadcrumb {
    margin-bottom: var(--space-5);
  }

  .breadcrumb ol {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: var(--space-1);

    color: var(--color-text-muted);

    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .breadcrumb li {
    display: flex;
    align-items: center;

    gap: var(--space-1);
  }

  .breadcrumb a {
    transition:
      color var(--transition-base);
  }

  .breadcrumb a:hover {
    color: var(--color-works);
  }

  .work-heading {
    display: grid;

    grid-template-columns:
      minmax(0, 1.6fr)
      minmax(220px, 0.55fr);

    align-items: end;

    gap: clamp(
      var(--space-4),
      6vw,
      var(--space-7)
    );
  }

  .work-title {
    min-width: 0;
  }

  .work-type {
    margin-bottom: var(--space-2);

    color: var(--color-works);

    font-size: 0.7rem;
    letter-spacing: 0.14em;
  }

  .work-title h1 {
    max-width: 820px;

    margin-bottom: var(--space-3);

    font-family: var(--font-display);

    font-size: clamp(
      3rem,
      4.8vw,
      4.75rem
    );

    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.025em;

    text-wrap: balance;
    line-break: strict;
  }

  .work-description {
    max-width: 680px;

    margin-bottom: 0;

    color: var(--color-text-muted);

    font-size: 1rem;
    line-height: 1.85;
  }

  .work-meta {
    width: 100%;

    margin: 0;

    display: grid;

    gap: var(--space-3);
  }

  .work-meta div {
    padding-top: var(--space-1);

    border-top: 1px solid
      var(--color-border);
  }

  .work-meta dt {
    margin-bottom: 0.35rem;

    color: var(--color-text-muted);

    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .work-meta dd {
    margin: 0;

    font-family: var(--font-serif);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* ========================================
     COVER
  ========================================= */

  .work-cover {
    padding-bottom: var(--space-7);
  }

  .work-cover :global(img) {
    width: 100%;

    height: clamp(
      420px,
      55vw,
      760px
    );

    object-fit: cover;
    object-position: center;
  }

  /* ========================================
     CONTENT
  ========================================= */

  .work-content {
    padding-block: var(--space-7);

    border-top: 1px solid
      var(--color-border);
  }

  .work-content-inner {
    display: grid;

    grid-template-columns:
      210px
      minmax(0, 720px);

    justify-content: center;
    align-items: start;

    gap: clamp(
      var(--space-4),
      5vw,
      var(--space-7)
    );
  }

  /* ========================================
     CASE STUDY INDEX
  ========================================= */
.work-index-mobile {
  display: none;
}
  .work-index {
    position: sticky;

    top: var(--space-3);

    align-self: start;

    min-width: 0;
    max-height: calc(100vh - var(--space-6));

    padding-top: 0.4rem;

    overflow: hidden;

    z-index: 2;
  }

  .work-index-title {
    margin-bottom: var(--space-2);

    color: var(--color-text-muted);

    font-size: 0.65rem;
    letter-spacing: 0.14em;
  }

  .work-index-nav {
    max-height: calc(
      100vh - 7rem
    );

    padding-right: 0.5rem;

    overflow-y: auto;
    overscroll-behavior: contain;

    scrollbar-width: thin;
  }

  .work-index ol {
    display: grid;

    gap: 0.15rem;
  }

  .work-index li {
    min-width: 0;
  }

  .work-index a {
    display: grid;

    grid-template-columns:
      24px
      minmax(0, 1fr);

    align-items: start;

    gap: 0.45rem;

    padding-block: 0.22rem;

    color: var(--color-text-muted);

    font-size: 0.72rem;
    line-height: 1.45;

    transition:
      color var(--transition-base);
  }

  .work-index a:hover {
    color: var(--color-works);
  }

  .work-index-number {
    color: var(--color-works);

    font-size: 0.62rem;
    letter-spacing: 0.06em;
  }

  .work-index-text {
    min-width: 0;

    overflow-wrap: anywhere;
  }

  /* ========================================
     ARTICLE
  ========================================= */

  .work-article {
    min-width: 0;

    width: 100%;
    max-width: 100%;
  }

  .work-article :global(h2) {
    margin-top: var(--space-7);
    margin-bottom: var(--space-2);

    scroll-margin-top: var(--space-4);

    font-size: clamp(
      1.65rem,
      2.4vw,
      2rem
    );

    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  .work-article :global(h2:first-child) {
    margin-top: 0;
  }

  .work-article :global(h3) {
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);

    font-size: 1.3rem;
    line-height: 1.5;
  }

  .work-article :global(p) {
    margin-bottom: var(--space-3);

    line-height: 2;
  }

  .work-article :global(blockquote) {
    margin:
      var(--space-4)
      0;

    padding:
      var(--space-2)
      var(--space-3);

    border-left: 2px solid
      var(--color-works);

    color: var(--color-text-muted);
  }

  .work-article :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .work-article :global(img) {
    width: 100%;

    margin-block: var(--space-4);
  }

  .work-article :global(ul),
  .work-article :global(ol) {
    margin-bottom: var(--space-3);

    padding-left: 1.25rem;
  }

  .work-article :global(li) {
    margin-bottom: 0.5rem;

    list-style: inherit;

    line-height: 1.8;
  }

  .work-article :global(pre) {
    max-width: 100%;

    margin-block: var(--space-4);
    padding: var(--space-3);

    overflow-x: auto;
  }

  .work-article :global(code) {
    overflow-wrap: anywhere;
  }

  /* ========================================
     BACK TO WORKS
  ========================================= */

  .back-to-works {
    padding-block: var(--space-5);

    border-top: 1px solid
      var(--color-border);
  }

  .back-to-works a {
    display: inline-flex;
    align-items: center;

    gap: var(--space-1);

    color: var(--color-text-muted);

    font-size: 0.75rem;
    letter-spacing: 0.1em;

    transition:
      color var(--transition-base);
  }

  .back-to-works a:hover {
    color: var(--color-works);
  }

  /* ========================================
     TABLET
  ========================================= */

  @media (max-width: 1024px) {

    .work-heading {
      grid-template-columns: 1fr;

      gap: var(--space-4);
    }

    .work-title h1 {
      max-width: 760px;

      font-size: clamp(
        3rem,
        7vw,
        4.25rem
      );
    }

    .work-meta {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }

    .work-content-inner {
      grid-template-columns: 1fr;

      gap: var(--space-5);
    }

    /*
      Tablet 開始不再使用左側 Sticky TOC。
      避免長目錄和正文互相干擾。
    */
    .work-index {
      position: static;

      max-height: none;

      padding-top: 0;
      padding-bottom: var(--space-3);

      overflow: visible;

      border-bottom: 1px solid
        var(--color-border);
    }

    .work-index-nav {
      max-height: none;

      padding-right: 0;

      overflow: visible;
    }

    .work-index ol {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.35rem;
}
  }

  /* ========================================
     MOBILE
  ========================================= */

  @media (max-width: 767px) {

    .work-hero {
      padding-top: var(--space-3);
      padding-bottom: var(--space-5);
    }

    .breadcrumb {
      margin-bottom: var(--space-4);
    }

    .work-heading {
      gap: var(--space-4);
    }

    .work-title h1 {
      max-width: 100%;

      margin-bottom: var(--space-2);

      font-size: clamp(
        2.35rem,
        10.5vw,
        3.25rem
      );

      line-height: 1.1;
      letter-spacing: -0.02em;

      text-wrap: pretty;
    }

    .work-description {
      font-size: 0.95rem;
      line-height: 1.8;
    }

    .work-meta {
      grid-template-columns: 1fr;

      gap: var(--space-2);
    }

    .work-cover {
      padding-bottom: var(--space-5);
    }

    .work-cover :global(img) {
      height: auto;

      aspect-ratio: 4 / 3;
    }

    .work-content {
      padding-block: var(--space-5);
    }

    .work-content-inner {
      gap: var(--space-4);
    }

    /*
  Mobile Case Study 目錄
  改為可展開 / 收合式目錄
*/
.work-index {
  width: 100%;

  padding: 0;

  border-bottom: 0;
}

.work-index-desktop {
  display: none;
}

.work-index-mobile {
  display: block;

  width: 100%;

  border-top: 1px solid
    var(--color-border);

  border-bottom: 1px solid
    var(--color-border);
}

.work-index-mobile summary {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: var(--space-2);

  padding-block: var(--space-2);

  color: var(--color-text-muted);

  font-size: 0.65rem;
  letter-spacing: 0.12em;

  cursor: pointer;

  list-style: none;
}

.work-index-mobile summary::-webkit-details-marker {
  display: none;
}

.work-index-toggle {
  display: inline-flex;
  align-items: center;

  gap: 0.5rem;
}

.work-index-arrow {
  display: inline-block;

  font-size: 0.85rem;

  transition:
    transform var(--transition-base);
}

.work-index-mobile[open]
.work-index-arrow {
  transform: rotate(180deg);
}

.work-index-mobile-nav {
  padding:
    var(--space-1)
    0
    var(--space-3);
}

.work-index-mobile-nav ol {
  display: grid;

  width: 100%;

  gap: 0;
}

.work-index-mobile-nav li {
  width: 100%;
}

.work-index-mobile-nav a {
  display: grid;

  grid-template-columns:
    2rem
    minmax(0, 1fr);

  align-items: start;

  gap: 0.5rem;

  width: 100%;

  padding-block: 0.6rem;

  border-top: 1px solid
    var(--color-border);

  color: var(--color-text-muted);

  font-size: 0.78rem;
  line-height: 1.55;
}

.work-index-mobile-nav
.work-index-number {
  padding-top: 0.05rem;

  color: var(--color-works);

  font-size: 0.65rem;
}

.work-index-mobile-nav
.work-index-text {
  overflow: visible;

  white-space: normal;
  text-overflow: unset;
  overflow-wrap: normal;
}
.work-article :global(h2) {
  margin-top: var(--space-6);
  margin-bottom: var(--space-2);

  scroll-margin-top: var(--space-4);

  font-size: 1.55rem;
  line-height: 1.45;
}

    .work-article :global(h3) {
      font-size: 1.2rem;
    }

    .work-article :global(p) {
      line-height: 1.9;
    }
  }
</style>