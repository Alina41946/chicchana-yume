---
import TravelCard from "./TravelCard.astro";
import tainanImage from "../assets/images/travel/tainan.jpg";
import keelungImage from "../assets/images/travel/keelung.jpg";

const destinations = [
  {
    title: "台南兩天一夜",
    location: "TAINAN",
    excerpt: "慢慢走、慢慢吃，在老城裡安排一趟舒服的小旅行。",
    href: "/taiwan/tainan/2-days/",
    image: tainanImage,
    imageAlt: "台南老城旅行街景",
  },
  {
    title: "基隆雨天散步",
    location: "KEELUNG",
    excerpt: "港口、老街與雨天，記錄一座城市安靜的樣子。",
    href: "/taiwan/keelung/rainy-day/",
    image: keelungImage,
    imageAlt: "基隆港口與城市街景",
  },
];
---

<section class="section taiwan-section">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="section-eyebrow">EXPLORE TAIWAN</p>
        <h2>Travel Around Taiwan</h2>
      </div>

      <a href="/taiwan/" class="view-all">
        EXPLORE TAIWAN
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="taiwan-layout">
      <div class="taiwan-feature">
        <div class="taiwan-map">
  <div class="taiwan-map-title">
    <span class="map-eyebrow">EXPLORE</span>
    <strong>TAIWAN</strong>
  </div>

  <nav class="taiwan-regions" aria-label="台灣旅遊地區">
    <a class="region north" href="/taiwan/north/">
      <span class="region-en">NORTH</span>
      <span class="region-zh">北部</span>
    </a>

    <a class="region central" href="/taiwan/central/">
      <span class="region-en">CENTRAL</span>
      <span class="region-zh">中部</span>
    </a>

    <a class="region south" href="/taiwan/south/">
      <span class="region-en">SOUTH</span>
      <span class="region-zh">南部</span>
    </a>

    <a class="region east" href="/taiwan/east/">
      <span class="region-en">EAST</span>
      <span class="region-zh">東部</span>
    </a>

    <a class="region islands" href="/taiwan/islands/">
      <span class="region-en">ISLANDS</span>
      <span class="region-zh">離島</span>
    </a>
  </nav>

  <p class="map-note" aria-hidden="true">
    little trips,<br />
    around home.
  </p>
</div>

        
      </div>

      <div class="travel-grid">
        {
          destinations.map((destination) => (
            <TravelCard {...destination} />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================
     Section Header
  ========================= */

  .section-header {
    margin-bottom: var(--space-4);

    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3);
  }

  .section-eyebrow {
    margin-bottom: var(--space-1);

    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
  }

  .section-header h2 {
    margin: 0;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);

    color: var(--color-taiwan);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .view-all span {
    transition: transform var(--transition-base);
  }

  .view-all:hover span {
    transform: translateX(4px);
  }

  /* =========================
     Desktop Layout
     Taiwan | Card | Card
  ========================= */

  .taiwan-layout {
    display: grid;

    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(0, 1.85fr);

    gap: var(--space-3);
    align-items: start;
  }

  .taiwan-feature {
    min-width: 0;
  }

  .travel-grid {
    min-width: 0;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  /* =========================
     Taiwan Map
  ========================= */

  .taiwan-map {
  position: relative;

  min-height: 420px;
  padding: var(--space-4);

  display: flex;
  flex-direction: column;
  gap: var(--space-4);

  background: var(--color-surface);
  border: 1px solid var(--color-border);

  overflow: hidden;
}

  /* =========================
     Map Title
  ========================= */

  .taiwan-map-title {
    align-self: start;
  }

  .map-eyebrow {
    display: block;

    margin-bottom: var(--space-1);

    color: var(--color-taiwan);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
  }

  .taiwan-map-title strong {
    font-family: var(--font-display);

    font-size: clamp(2.5rem, 4vw, 4.5rem);
    font-weight: 400;
    line-height: 1;
  }

  /* =========================
     Taiwan Regions
  ========================= */

  .taiwan-regions {
  width: 100%;

  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-2);
}

  .region {
  position: static;

  width: 100%;
  min-width: 0;
  padding: 0.65rem 0.85rem;

  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);

  background: var(--color-bg);
  border: 1px solid var(--color-border);

  transition:
    transform var(--transition-base),
    border-color var(--transition-base),
    background var(--transition-base);
}

  .region:hover,
  .region:focus-visible {
    transform: translateY(-3px);

    border-color: var(--color-taiwan);

    background: color-mix(
      in srgb,
      var(--color-taiwan) 8%,
      var(--color-bg)
    );
  }

  .region-en {
    color: var(--color-taiwan);

    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .region-zh {
    font-family: var(--font-serif);
    font-size: 0.9rem;
  }

  
  /* =========================
     Handwritten Note
  ========================= */

  .map-note {
    position: absolute;

    left: var(--space-4);
    bottom: var(--space-3);

    margin: 0;

    color: var(--color-taiwan);

    font-family: var(--font-serif);
    font-style: italic;
    line-height: 1.5;

    transform: rotate(-4deg);
  }

  /* =========================
     Medium
     Taiwan
     Card | Card
  ========================= */

  @media (max-width: 1100px) {
    .taiwan-layout {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .taiwan-map {
      min-height: 360px;
    }

    .travel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* =========================
     Mobile
     Taiwan
     Card
     Card
  ========================= */

  @media (max-width: 767px) {
    .section-header {
      align-items: start;
      flex-direction: column;
    }

    .taiwan-map {
      min-height: auto;
      padding: var(--space-3);

      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .taiwan-map-title strong {
      font-size: clamp(2.5rem, 13vw, 4rem);
    }

    .taiwan-regions {
      width: 100%;
      min-height: 0;

      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2);
    }

    .region {
      position: static;

      min-width: 0;
      width: 100%;
    }

    .islands {
      grid-column: 1 / -1;
    }

    .map-note {
      display: none;
    }

    .travel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>