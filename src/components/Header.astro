---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const navItems = [
  { label: "HOME", href: base },
  { label: "LANGUAGE", href: `${base}language/` },
  { label: "JAPAN WH", href: `${base}japan-wh/` },
  { label: "TAIWAN", href: `${base}taiwan/` },
  { label: "WORKS", href: `${base}works/`, portfolioOnly: true },
  { label: "ABOUT", href: `${base}about/` },
];
---

<header class="site-header">
  <div class="container header-inner">

    <a class="site-brand" href={base} aria-label="回首頁">
      <span>ちっちゃな私には、</span>
      <span>ちっちゃな夢があります。</span>
    </a>

    <nav class="desktop-nav" aria-label="主要導覽">
      <ul>
        {
          navItems.map((item) => (
            <li
              class:list={[
                {
                  "portfolio-nav-item":
                    item.portfolioOnly,
                },
              ]}
              hidden={item.portfolioOnly}
            >
              <a href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button
        class="icon-button"
        type="button"
        aria-label="搜尋"
      >
        ⌕
      </button>

      <button
        class="menu-button"
        type="button"
        aria-label="開啟選單"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        ☰
      </button>
    </div>

  </div>

  <div
    class="mobile-menu"
    id="mobile-menu"
    hidden
  >
    <nav aria-label="手機導覽">
      <ul>
        {
          navItems.map((item) => (
            <li
              class:list={[
                {
                  "portfolio-nav-item":
                    item.portfolioOnly,
                },
              ]}
              hidden={item.portfolioOnly}
            >
              <a href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .header-inner {
    min-height: 80px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: var(--space-4);
  }

  .site-brand {
    display: flex;
    flex-direction: column;

    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.5;

    white-space: nowrap;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;

    gap: var(--space-4);
  }

  .desktop-nav a {
    position: relative;

    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  .desktop-nav a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -8px;

    width: 100%;
    height: 1px;

    background: var(--color-japan);

    transform: scaleX(0);
    transform-origin: left;

    transition:
      transform var(--transition-base);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;

    gap: var(--space-1);
  }

  .icon-button,
  .menu-button {
    width: 44px;
    height: 44px;

    display: grid;
    place-items: center;

    border: 0;
    background: transparent;

    color: var(--color-text);

    cursor: pointer;
  }

  .menu-button {
    display: none;
  }

  .mobile-menu {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .mobile-menu nav {
    padding:
      var(--space-3)
      var(--page-padding);
  }

  .mobile-menu ul {
    display: grid;

    gap: var(--space-2);
  }

  .mobile-menu a {
    display: block;

    padding-block: var(--space-1);

    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  .mobile-menu[hidden],
  .portfolio-nav-item[hidden] {
    display: none;
  }

  @media (max-width: 1100px) {
    .desktop-nav {
      display: none;
    }

    .menu-button {
      display: grid;
    }

    .header-inner {
      gap: var(--space-2);
    }
  }

  @media (max-width: 767px) {
    .header-inner {
      min-height: 72px;
    }

    .site-brand {
      font-size: 0.8rem;
    }
  }

  @media (min-width: 1101px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const portfolioStorageKey =
    "chicchana-yume-portfolio-mode";

  const currentURL =
    new URL(window.location.href);

  const isPortfolioEntry =
    currentURL.searchParams.get(
      "portfolio"
    ) === "1";

  if (isPortfolioEntry) {
    sessionStorage.setItem(
      portfolioStorageKey,
      "true"
    );
  }

  const isPortfolioMode =
    sessionStorage.getItem(
      portfolioStorageKey
    ) === "true";

  if (isPortfolioMode) {
    const portfolioNavItems =
      document.querySelectorAll(
        ".portfolio-nav-item"
      );

    portfolioNavItems.forEach((item) => {
      item.removeAttribute("hidden");
    });
  }

  const menuButton =
    document.querySelector(
      ".menu-button"
    );

  const mobileMenu =
    document.querySelector(
      "#mobile-menu"
    );

  if (menuButton && mobileMenu) {
    menuButton.addEventListener(
      "click",
      () => {
        const isOpen =
          menuButton.getAttribute(
            "aria-expanded"
          ) === "true";

        menuButton.setAttribute(
          "aria-expanded",
          String(!isOpen)
        );

        if (isOpen) {
          mobileMenu.setAttribute(
            "hidden",
            ""
          );

          menuButton.setAttribute(
            "aria-label",
            "開啟選單"
          );
        } else {
          mobileMenu.removeAttribute(
            "hidden"
          );

          menuButton.setAttribute(
            "aria-label",
            "關閉選單"
          );
        }
      }
    );
  }
</script>