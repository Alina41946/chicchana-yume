---
const navItems = [
  { label: "HOME", href: "/" },
  { label: "LANGUAGE", href: "/language/" },
  { label: "JAPAN WH", href: "/japan-wh/" },
  { label: "TAIWAN", href: "/taiwan/" },
  { label: "WORKS", href: "/works/" },
  { label: "ABOUT", href: "/about/" },
];
---

<header class="site-header">
  <div class="container header-inner">

    <a class="site-brand" href="/" aria-label="回首頁">
      <span>ちっちゃな私には、</span>
      <span>ちっちゃな夢があります。</span>
    </a>

    <nav class="desktop-nav" aria-label="主要導覽">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button
        class="icon-button"
        type="button"
        aria-label="搜尋"
      >
        ⌕
      </button>

      <button
        class="menu-button"
        type="button"
        aria-label="開啟選單"
      >
        ☰
      </button>
    </div>

  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .header-inner {
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-brand {
    display: flex;
    flex-direction: column;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.5;
    white-space: nowrap;
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .desktop-nav a {
    position: relative;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  .desktop-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 100%;
    height: 1px;
    background: var(--color-japan);

    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .icon-button,
  .menu-button {
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;

    width: 44px;
    height: 44px;

    display: grid;
    place-items: center;
  }

  .menu-button {
    display: none;
  }

  @media (max-width: 900px) {
    .desktop-nav {
      display: none;
    }

    .menu-button {
      display: grid;
    }
  }

  @media (max-width: 767px) {
    .header-inner {
      min-height: 72px;
    }

    .site-brand {
      font-size: 0.8rem;
    }
  }
</style>