---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const navItems = [
  { label: "HOME", href: base },
  { label: "LANGUAGE", href: `${base}language/` },
  { label: "JAPAN WH", href: `${base}japan-wh/` },
  { label: "TAIWAN", href: `${base}taiwan/` },
  { label: "ABOUT", href: `${base}about/` },
];
---

<header
  class="site-header"
  data-base={base}
>
  <div class="container header-inner">

    <a
      class="site-brand"
      href={base}
      aria-label="回首頁"
    >
      <span>ちっちゃな私には、</span>
      <span>ちっちゃな夢があります。</span>
    </a>

    <div class="header-right">
      <nav
        class="desktop-nav"
        aria-label="主要導覽"
      >
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div
        class="portfolio-entry"
        aria-label="作品集入口"
      ></div>

      <div class="header-actions">
        
        <button
          class="menu-button"
          type="button"
          aria-label="開啟選單"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          ☰
        </button>
      </div>
    </div>

  </div>

  <div
    class="mobile-menu"
    id="mobile-menu"
    hidden
  >
    <nav aria-label="手機導覽">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div
        class="mobile-portfolio-entry"
      ></div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .header-inner {
    min-height: 80px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: var(--space-4);
  }

  .site-brand {
    display: flex;
    flex-direction: column;

    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.5;

    white-space: nowrap;
  }

  .header-right {
    display: flex;
    align-items: center;

    gap: var(--space-3);
  }

  .desktop-nav ul {
    display: flex;
    align-items: center;

    gap: var(--space-4);
  }

  .desktop-nav a {
    position: relative;

    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }

  .desktop-nav a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -8px;

    width: 100%;
    height: 1px;

    background: var(--color-japan);

    transform: scaleX(0);
    transform-origin: left;

    transition:
      transform var(--transition-base);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after {
    transform: scaleX(1);
  }

  /* Portfolio Mode */
  .portfolio-entry:empty {
    display: none;
  }

  .portfolio-entry :global(.portfolio-link) {
  position: relative;

  display: inline-flex;
  align-items: center;
  gap: 0.4rem;

  padding-block: 0.35rem;

  color: var(--color-works);

  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  line-height: 1;
}

.portfolio-entry :global(.portfolio-link)::after {
  content: "";

  position: absolute;
  left: 0;
  bottom: 0;

  width: 100%;
  height: 1px;

  background: var(--color-works);

  transform: scaleX(0.25);
  transform-origin: left;

  transition:
    transform var(--transition-base);
}

.portfolio-entry :global(.portfolio-link:hover)::after,
.portfolio-entry :global(.portfolio-link:focus-visible)::after {
  transform: scaleX(1);
}

.portfolio-entry :global(.portfolio-arrow) {
  font-size: 0.85rem;
  line-height: 1;

  transition:
    transform var(--transition-base);
}

.portfolio-entry
  :global(.portfolio-link:hover .portfolio-arrow) {
  transform: translate(2px, -2px);
}


  .header-actions {
    display: flex;
    align-items: center;

    gap: var(--space-1);
  }

    .menu-button {
    width: 44px;
    height: 44px;

    display: grid;
    place-items: center;

    border: 0;
    background: transparent;

    color: var(--color-text);

    cursor: pointer;
  }

  .menu-button {
    display: none;
  }

  .mobile-menu {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .mobile-menu nav {
    padding:
      var(--space-3)
      var(--page-padding);
  }

  .mobile-menu ul {
    display: grid;

    gap: var(--space-2);
  }

  .mobile-menu a {
    display: block;

    padding-block: var(--space-1);

    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  /* Mobile Portfolio */
  .mobile-portfolio-entry:empty {
    display: none;
  }

  .mobile-portfolio-entry:not(:empty) {
    margin-top: var(--space-3);
    padding-top: var(--space-3);

    border-top: 1px solid var(--color-border);
  }

  .mobile-portfolio-entry
    :global(.portfolio-link) {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding-block: 0.6rem;

    color: var(--color-works);

    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .mobile-portfolio-entry
    :global(.portfolio-arrow) {
    font-size: 1rem;
  }

  @media (max-width: 1100px) {
    .desktop-nav,
    .portfolio-entry {
      display: none;
    }

    .menu-button {
      display: grid;
    }

    .header-inner {
      gap: var(--space-2);
    }
  }

  @media (max-width: 767px) {
    .header-inner {
      min-height: 72px;
    }

    .site-brand {
      font-size: 0.8rem;
    }
  }

  @media (min-width: 1101px) {
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const portfolioStorageKey =
    "chicchana-yume-portfolio-mode";

  const currentURL =
    new URL(window.location.href);

  const isPortfolioEntry =
    currentURL.searchParams.get(
      "portfolio"
    ) === "1";

  if (isPortfolioEntry) {
    sessionStorage.setItem(
      portfolioStorageKey,
      "true"
    );
  }

  const isPortfolioMode =
    sessionStorage.getItem(
      portfolioStorageKey
    ) === "true";

  const siteHeader =
    document.querySelector<HTMLElement>(
      ".site-header"
    );

  const base =
    siteHeader?.dataset.base ?? "/";

  /*
   * Portfolio Mode
   * 一般 HTML 不輸出 Works URL。
   * 僅在 Portfolio Mode 動態建立。
   */
  if (isPortfolioMode) {
    const createPortfolioLink = () => {
      const link =
        document.createElement("a");

      link.href = `${base}works/`;
      link.className = "portfolio-link";
      link.setAttribute(
        "aria-label",
        "前往 Portfolio"
      );

      const label =
        document.createElement("span");

      label.textContent = "PORTFOLIO";

      const arrow =
        document.createElement("span");

      arrow.className =
        "portfolio-arrow";

      arrow.textContent = "↗";
      arrow.setAttribute(
        "aria-hidden",
        "true"
      );

      link.append(label, arrow);

      return link;
    };

    const desktopEntry =
      document.querySelector(
        ".portfolio-entry"
      );

    const mobileEntry =
      document.querySelector(
        ".mobile-portfolio-entry"
      );

    desktopEntry?.appendChild(
      createPortfolioLink()
    );

    mobileEntry?.appendChild(
      createPortfolioLink()
    );
  }

  const menuButton =
    document.querySelector<HTMLButtonElement>(
      ".menu-button"
    );

  const mobileMenu =
    document.querySelector<HTMLElement>(
      "#mobile-menu"
    );

  if (menuButton && mobileMenu) {
    menuButton.addEventListener(
      "click",
      () => {
        const isOpen =
          menuButton.getAttribute(
            "aria-expanded"
          ) === "true";

        menuButton.setAttribute(
          "aria-expanded",
          String(!isOpen)
        );

        if (isOpen) {
          mobileMenu.setAttribute(
            "hidden",
            ""
          );

          menuButton.setAttribute(
            "aria-label",
            "開啟選單"
          );
        } else {
          mobileMenu.removeAttribute(
            "hidden"
          );

          menuButton.setAttribute(
            "aria-label",
            "關閉選單"
          );
        }
      }
    );
  }
</script>