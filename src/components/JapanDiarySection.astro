---
import { getCollection } from "astro:content";
import ArticleCard from "./ArticleCard.astro";

const posts = await getCollection(
  "blog",
  ({ data }) =>
    !data.draft &&
    data.category === "japan-wh"
);

const japanPosts = posts
  .sort(
    (a, b) =>
      b.data.publishedDate.getTime() -
      a.data.publishedDate.getTime()
  )
  .slice(0, 3);

const base = import.meta.env.BASE_URL;
---

<section class="section japan-diary">
  <div class="container">

    <div class="section-header">
      <div>
        <p class="section-eyebrow">
          JAPAN WH
        </p>

        <h2>365 Days in Japan</h2>
      </div>

     <a href={`${base}japan-wh/`} class="view-all">
        VIEW ALL STORIES
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {
      japanPosts.length > 0 ? (
        <div class="diary-grid">
          {
            japanPosts.map((post) => (
              <ArticleCard
                title={post.data.title}
                excerpt={post.data.description}
                category="日本生活"
                date={post.data.publishedDate.toLocaleDateString("zh-TW")}
                readTime={post.data.readTime}
                href={`${base}${post.id.replace(/\.mdx?$/, "")}/`}
                image={post.data.image}
                imageAlt={post.data.imageAlt ?? ""}
                accent="var(--color-japan)"
              />
            ))
          }
        </div>
      ) : (
        <p class="empty-message">
          日本 Working Holiday 的故事準備中。
        </p>
      )
    }

  </div>
</section>

<style>
  .section-header {
    margin-bottom: var(--space-4);

    display: flex;
    justify-content: space-between;
    align-items: end;

    gap: var(--space-3);
  }

  .section-eyebrow {
    margin-bottom: var(--space-1);

    color: var(--color-text-muted);

    font-size: 0.75rem;
    letter-spacing: 0.15em;
  }

  .section-header h2 {
    margin: 0;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);

    color: var(--color-japan);

    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .view-all span {
    transition:
      transform var(--transition-base);
  }

  .view-all:hover span {
    transform: translateX(4px);
  }

  .diary-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: var(--space-3);
  }

  .empty-message {
    margin-bottom: 0;

    color: var(--color-text-muted);
  }

  @media (max-width: 1100px) {
    .diary-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .section-header {
      align-items: start;
      flex-direction: column;
    }

    .diary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>