---
import { Image } from "astro:assets";
import heroImage from "../assets/images/home-hero.jpg";
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-content">
      <p class="hero-eyebrow">A SMALL PERSONAL JOURNAL</p>

      <h1 class="hero-title">
        Learn.<br />
        Explore.<br />
        <em>Create.</em>
      </h1>

      <p class="hero-description">
        語言學習 × 日本一年打工度假 × 台灣旅遊 × 設計作品
      </p>

      <a class="hero-button" href="#explore">
        EXPLORE
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="hero-visual">
      <Image
  src={heroImage}
  alt="日本海邊鐵道與電車的旅行風景"
  class="hero-image"
  widths={[640, 960, 1280]}
  sizes="(max-width: 900px) 100vw, 55vw"
  loading="eager"
  fetchpriority="high"
/>

      <p class="hero-note" aria-hidden="true">
        small steps,<br />
        big dreams.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    padding-block: var(--space-6);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: var(--space-6);
  }

  .hero-eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
  }

  .hero-title {
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .hero-title em {
    color: var(--color-japan);
    font-weight: 400;
  }

  .hero-description {
    max-width: 440px;
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);

    min-height: 48px;
    padding-inline: var(--space-3);

    background: var(--color-text);
    color: var(--color-bg);

    font-size: 0.75rem;
    letter-spacing: 0.1em;

    transition:
      background var(--transition-base),
      transform var(--transition-base);
  }

  .hero-button span {
    transition: transform var(--transition-base);
  }

  .hero-button:hover {
    background: var(--color-japan);
  }

  .hero-button:hover span {
    transform: translateX(4px);
  }

  .hero-visual {
    position: relative;
  }

 .hero-image {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}

  .hero-note {
    position: absolute;
    right: -10px;
    bottom: -40px;

    color: var(--color-japan);
    font-family: var(--font-serif);
    font-size: 1rem;
    font-style: italic;
    line-height: 1.5;

    transform: rotate(-4deg);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
    }

    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-content {
      max-width: 600px;
    }

    .hero-visual {
      max-width: 700px;
    }
  }

  @media (max-width: 767px) {
    .hero {
      padding-block: var(--space-5);
    }

    .hero-inner {
      gap: var(--space-5);
    }

    .hero-title {
      font-size: clamp(3rem, 15vw, 4rem);
    }

    .hero-description {
      font-size: 0.9rem;
    }

    .hero-image {
  aspect-ratio: 4 / 5;
}

    .hero-note {
      right: 8px;
      bottom: -35px;
    }
  }
</style>