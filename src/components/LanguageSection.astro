---
import { getCollection } from "astro:content";
import ArticleCard from "./ArticleCard.astro";

const posts = await getCollection(
  "blog",
  ({ data }) =>
    !data.draft &&
    data.category === "language"
);

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const latestPosts = posts
  .sort(
    (a, b) =>
      b.data.publishedDate.getTime() -
      a.data.publishedDate.getTime()
  )
  .slice(0, 3);

const categoryInfo = {
  language: {
    label: "語言學習",
    accent: "var(--color-language)",
  },

  "japan-wh": {
    label: "日本生活",
    accent: "var(--color-japan)",
  },

  taiwan: {
    label: "台灣旅行",
    accent: "var(--color-taiwan)",
  },
};
---

<section class="section latest-stories">
  <div class="container">
    <div class="section-header">
      <div>
       <p class="section-eyebrow">LANGUAGE</p>
<h2>Language Notes</h2>
      </div>

      <a href={`${base}language/`} class="view-all">
        VIEW ALL
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="article-grid">
      {
        latestPosts.map((post) => {
          const category =
            categoryInfo[
              post.data.category as keyof typeof categoryInfo
            ];

          return (
            <ArticleCard
              title={post.data.title}
              excerpt={post.data.description}
              category={category.label}
              date={post.data.publishedDate.toLocaleDateString(
                "zh-TW"
              )}
              readTime={post.data.readTime}
              href={`${base}${post.id.replace(/\.mdx?$/, "")}/`}
              image={post.data.image}
              imageAlt={post.data.imageAlt ?? ""}
              accent={category.accent}
            />
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .section-header {
    margin-bottom: var(--space-4);

    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .section-eyebrow {
    margin-bottom: var(--space-1);

    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
  }

  .section-header h2 {
    margin: 0;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);

    color: var(--color-japan);

    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .view-all span {
    transition: transform var(--transition-base);
  }

  .view-all:hover span {
    transform: translateX(4px);
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  @media (max-width: 900px) {
    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .section-header {
      align-items: start;
      flex-direction: column;
    }

    .article-grid {
      grid-template-columns: 1fr;
    }
  }
</style>