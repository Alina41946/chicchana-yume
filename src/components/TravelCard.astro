---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  location: string;
  excerpt: string;
  href: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  location,
  excerpt,
  href,
  image,
  imageAlt = "",
} = Astro.props;
---

<article class="travel-card">
  <a href={href}>
    <div class="travel-image">
      {
        image ? (
          <Image
            src={image}
            alt={imageAlt}
            widths={[400, 600, 800]}
            sizes="(max-width: 767px) 100vw, 50vw"
            loading="lazy"
          />
        ) : (
          <span>TRAVEL IMAGE</span>
        )
      }
    </div>

    <div class="travel-content">
      <span class="location">{location}</span>

      <h3>{title}</h3>

      <p>{excerpt}</p>

      <span class="travel-link">
        EXPLORE
        <span aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>

<style>
  .travel-card {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .travel-image {
    aspect-ratio: 3 / 2;
    overflow: hidden;

    display: grid;
    place-items: center;

    background: var(--color-surface);
    color: var(--color-text-muted);

    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .travel-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .travel-card:hover .travel-image :global(img) {
    transform: scale(1.03);
  }

  .travel-content {
    padding: var(--space-3);
  }

  .location {
    display: inline-block;
    margin-bottom: var(--space-1);

    color: var(--color-taiwan);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .travel-content h3 {
    margin-bottom: var(--space-1);
    font-size: 1.2rem;
  }

  .travel-content p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .travel-link {
    display: inline-flex;
    gap: var(--space-1);

    color: var(--color-taiwan);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
</style>