---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  date: string;
  title: string;
  excerpt: string;
  category: string;
  href: string;
  image?: ImageMetadata;
  imageAlt?: string;
  accent?: string;
}

const {
  date,
  title,
  excerpt,
  category,
  href,
  image,
  imageAlt = "",
  accent = "var(--color-japan)",
} = Astro.props;
---

<article class="diary-card">
  <a href={href}>
    <div class="diary-image">
  {
    image ? (
      <Image
        src={image}
        alt={imageAlt}
        widths={[400, 600, 800]}
        sizes="(max-width: 767px) 100vw, 33vw"
        loading="lazy"
      />
    ) : (
      <span>DIARY IMAGE</span>
    )
  }
</div>

    <div class="diary-content">
      <div class="diary-top">
        <time>{date}</time>

        <span
          class="diary-tag"
          style={`--accent:${accent};`}
        >
          {category}
        </span>
      </div>

      <h3>{title}</h3>

      <p>{excerpt}</p>

      <span class="read-more">
        READ MORE
        <span aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>

<style>
  .diary-card {
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

 .diary-image {
  aspect-ratio: 4 / 3;
  overflow: hidden;
}

.diary-image :global(img) {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

  .diary-content {
    padding: var(--space-3);
  }

  .diary-top {
    margin-bottom: var(--space-2);

    display: flex;
    justify-content: space-between;
    gap: var(--space-2);

    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .diary-tag {
    padding: 0.2rem 0.5rem;

    background: color-mix(
      in srgb,
      var(--accent) 12%,
      transparent
    );

    color: var(--accent);
  }

  .diary-content h3 {
    margin-bottom: var(--space-1);
    font-size: 1.1rem;
  }

  .diary-content p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .read-more {
    display: inline-flex;
    gap: var(--space-1);

    color: var(--color-japan);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
</style>