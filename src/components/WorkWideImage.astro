---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const {
  src,
  alt,
  caption,
} = Astro.props;
---

<figure class="work-wide-image">
  <Image
    src={src}
    alt={alt}
    widths={[800, 1200, 1600]}
    sizes="(max-width: 767px) 100vw, 680px"
    loading="lazy"
  />

  {
    caption && (
      <figcaption>
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .work-wide-image {
    width: 100%;
    max-width: 100%;

    margin:
      var(--space-5)
      0
      var(--space-6);

    overflow: hidden;
  }

  .work-wide-image :global(img) {
    display: block;

    width: 100%;
    height: auto;

    object-fit: contain;
  }

  .work-wide-image figcaption {
    margin-top: var(--space-1);

    color: var(--color-text-muted);

    font-size: 0.75rem;
    line-height: 1.6;
    text-align: center;
  }

  @media (max-width: 767px) {
    .work-wide-image {
      margin:
        var(--space-4)
        0
        var(--space-5);
    }
  }
</style>