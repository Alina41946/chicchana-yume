---
import CategoryCard from "./CategoryCard.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const categories = [
  {
    number: "01",
    title: "LANGUAGE",
    subtitle: "日文・韓文自學與學習紀錄",
    href: `${base}language/`,
    accent: "var(--color-language)",
  },
  {
    number: "02",
    title: "JAPAN WH",
    subtitle: "一年日本打工度假與生活紀錄",
    href: `${base}japan-wh/`,
    accent: "var(--color-japan)",
  },
  {
    number: "03",
    title: "TAIWAN",
    subtitle: "台灣旅行、城市散步與地方探索",
    href: `${base}taiwan/`,
    accent: "var(--color-taiwan)",
  },
];

const worksCategory = {
  number: "04",
  title: "WORKS",
  subtitle: "Web、UI、Graphic 與設計作品",
  href: `${base}works/`,
  accent: "var(--color-works)",
};
---

<section id="explore" class="section explore-section">
  <div class="container">
    <div class="section-heading">
      <p class="section-eyebrow">EXPLORE</p>
      <h2>Explore My World</h2>
    </div>

    <div class="category-grid">
      {
        categories.map((category) => (
          <CategoryCard {...category} />
        ))
      }

      <div
        class="portfolio-category"
        hidden
      >
        <CategoryCard {...worksCategory} />
      </div>
    </div>
  </div>
</section>

<style>
  .section-heading {
    margin-bottom: var(--space-4);
  }

  .section-eyebrow {
    margin-bottom: var(--space-1);

    color: var(--color-text-muted);

    font-size: 0.75rem;
    letter-spacing: 0.15em;
  }

  .section-heading h2 {
    margin-bottom: 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns:
      repeat(4, minmax(0, 1fr));

    gap: var(--space-3);
  }

  .portfolio-category[hidden] {
    display: none;
  }

  @media (max-width: 1100px) {
    .category-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const portfolioStorageKey =
    "chicchana-yume-portfolio-mode";

  const isPortfolioMode =
    sessionStorage.getItem(
      portfolioStorageKey
    ) === "true";

  if (isPortfolioMode) {
    const portfolioCategory =
      document.querySelector(
        ".portfolio-category"
      );

    portfolioCategory?.removeAttribute(
      "hidden"
    );
  }
</script>