---
import CategoryCard from "./CategoryCard.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const categories = [
  {
    number: "01",
    title: "LANGUAGE",
    subtitle: "日文・韓文自學與學習紀錄",
    href: `${base}language/`,
    accent: "var(--color-language)",
  },
  {
    number: "02",
    title: "JAPAN WH",
    subtitle: "一年日本打工度假與生活紀錄",
    href: `${base}japan-wh/`,
    accent: "var(--color-japan)",
  },
  {
    number: "03",
    title: "TAIWAN",
    subtitle: "台灣旅行、城市散步與地方探索",
    href: `${base}taiwan/`,
    accent: "var(--color-taiwan)",
  },
];
---

<section
  id="explore"
  class="section explore-section"
  data-base={base}
>
  <div class="container">
    <div class="section-heading">
      <p class="section-eyebrow">
        EXPLORE
      </p>

      <h2>Explore My World</h2>
    </div>

    <div class="category-grid">
      {
        categories.map((category) => (
          <CategoryCard {...category} />
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-heading {
    margin-bottom: var(--space-4);
  }

  .section-eyebrow {
    margin-bottom: var(--space-1);

    color: var(--color-text-muted);

    font-size: 0.75rem;
    letter-spacing: 0.15em;
  }

  .section-heading h2 {
    margin-bottom: 0;
  }

  /*
   * 一般模式：
   * 3 張卡平均填滿
   */
  .category-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: var(--space-3);
  }

  /*
   * Portfolio Mode：
   * 加入第 4 張後改成四欄
   */
  .explore-section.is-portfolio
    .category-grid {
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
  }

  @media (max-width: 1100px) {
    .category-grid,
    .explore-section.is-portfolio
      .category-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .category-grid,
    .explore-section.is-portfolio
      .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const portfolioStorageKey =
    "chicchana-yume-portfolio-mode";

  const isPortfolioMode =
    sessionStorage.getItem(
      portfolioStorageKey
    ) === "true";

  if (isPortfolioMode) {
    const exploreSection =
      document.querySelector<HTMLElement>(
        ".explore-section"
      );

    const categoryGrid =
      exploreSection?.querySelector(
        ".category-grid"
      );

    const firstCard =
      categoryGrid?.querySelector<HTMLAnchorElement>(
        ".category-card"
      );

    const base =
      exploreSection?.dataset.base ?? "/";

    if (
      exploreSection &&
      categoryGrid &&
      firstCard
    ) {
      exploreSection.classList.add(
        "is-portfolio"
      );

      /*
       * 複製既有 CategoryCard，
       * 所以視覺、hover、RWD
       * 全部與原本卡片一致。
       */
      const portfolioCard =
        firstCard.cloneNode(
          true
        ) as HTMLAnchorElement;

      portfolioCard.href =
        `${base}works/`;

      portfolioCard.style.setProperty(
        "--accent",
        "var(--color-works)"
      );

      const number =
        portfolioCard.querySelector(
          ".category-number"
        );

      const title =
        portfolioCard.querySelector("h3");

      const subtitle =
        portfolioCard.querySelector("p");

      if (number) {
        number.textContent = "04";
      }

      if (title) {
        title.textContent =
          "PORTFOLIO";
      }

      if (subtitle) {
        subtitle.textContent =
          "Web、UI、Graphic 與設計作品";
      }

      categoryGrid.appendChild(
        portfolioCard
      );
    }
  }
</script>