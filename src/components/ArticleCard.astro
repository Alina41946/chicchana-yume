---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  excerpt: string;
  category: string;
  date: string;
  readTime: string;
  href: string;
  image?: ImageMetadata;
  imageAlt?: string;
  accent?: string;
}

const {
  title,
  excerpt,
  category,
  date,
  readTime,
  href,
  image,
  imageAlt = "",
  accent = "var(--color-japan)",
} = Astro.props;
---

<article class="article-card">
  <a href={href} class="article-link">
    <div class="article-image">
      {
        image ? (
          <Image
            src={image}
            alt={imageAlt}
            widths={[400, 600, 800]}
            sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 33vw"
            loading="lazy"
          />
        ) : (
          <span>ARTICLE IMAGE</span>
        )
      }
    </div>

    <div class="article-content">
      <span
        class="article-tag"
        style={`--accent:${accent};`}
      >
        {category}
      </span>

      <h3>{title}</h3>

      <p>{excerpt}</p>

      <div class="article-meta">
        <time>{date}</time>
        <span>·</span>
        <span>{readTime}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .article-card {
    border: 1px solid var(--color-border);
    background: var(--color-bg);

    transition:
      transform var(--transition-base),
      border-color var(--transition-base);
  }

  .article-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-text-muted);
  }

  .article-link {
    display: block;
  }

  .article-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;

    display: grid;
    place-items: center;

    background: var(--color-surface);

    color: var(--color-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .article-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;

    transition: transform var(--transition-slow);
  }

  .article-card:hover .article-image :global(img) {
    transform: scale(1.03);
  }

  .article-content {
    padding: var(--space-3);
  }

  .article-tag {
    display: inline-block;

    margin-bottom: var(--space-2);
    padding: 0.2rem 0.5rem;

    background: color-mix(
      in srgb,
      var(--accent) 12%,
      transparent
    );

    color: var(--accent);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .article-content h3 {
    margin-bottom: var(--space-1);
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .article-content p {
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .article-meta {
    display: flex;
    gap: var(--space-1);

    color: var(--color-text-muted);
    font-size: 0.75rem;
  }
</style>