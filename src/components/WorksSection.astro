---
import { getCollection } from "astro:content";
import WorkCard from "./WorkCard.astro";

const posts = await getCollection(
  "blog",
  ({ data }) =>
    !data.draft &&
    data.category === "works"
);

const workPosts = posts
  .sort(
    (a, b) =>
      b.data.publishedDate.getTime() -
      a.data.publishedDate.getTime()
  )
  .slice(0, 3);

const projectTypeLabels = {
  "web-design": "WEB DESIGN",
  "web-development": "WEB DEVELOPMENT",
  "graphic-design": "GRAPHIC DESIGN",
  motion: "MOTION",
  "personal-project": "PERSONAL PROJECT",
};

const base = import.meta.env.BASE_URL;
---

<section class="section works-section">
  <div class="container">

    <div class="section-header">
      <div>
        <p class="section-eyebrow">
          PORTFOLIO
        </p>

        <h2>Selected Works</h2>
      </div>

      <a href={`${base}works/`} class="view-all">
        VIEW ALL WORKS
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {
      workPosts.length > 0 ? (
        <div class="project-grid">
          {
            workPosts.map((post) => {
              const projectType =
                post.data.projectType
                  ? projectTypeLabels[
                      post.data.projectType as keyof typeof projectTypeLabels
                    ]
                  : "PROJECT";

              return (
                <WorkCard
                  title={post.data.title}
                  description={post.data.description}
                  href={`${base}${post.id.replace(/\.mdx?$/, "")}/`}
                  type={projectType}
                  year={post.data.year}
                  role={post.data.role}
                  image={post.data.image}
                  imageAlt={post.data.imageAlt ?? ""}
                />
              );
            })
          }
        </div>
      ) : (
        <p class="empty-message">
          作品整理中，之後會慢慢放上來。
        </p>
      )
    }

  </div>
</section>

<style>
  .section-header {
    margin-bottom: var(--space-4);

    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-3);
  }

  .section-eyebrow {
    margin-bottom: var(--space-1);

    color: var(--color-text-muted);

    font-size: 0.75rem;
    letter-spacing: 0.15em;
  }

  .section-header h2 {
    margin: 0;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);

    color: var(--color-works);

    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .view-all span {
    transition:
      transform var(--transition-base);
  }

  .view-all:hover span {
    transform: translateX(4px);
  }

  .project-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: var(--space-3);
  }

  .empty-message {
    margin-bottom: 0;

    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .project-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .section-header {
      align-items: start;
      flex-direction: column;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>