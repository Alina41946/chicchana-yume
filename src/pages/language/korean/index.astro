---
import { getCollection } from "astro:content";

import Layout from "../../../layouts/Layout.astro";
import ArticleList from "../../../components/ArticleList.astro";

const posts = await getCollection(
  "blog",
  ({ data }) =>
    !data.draft &&
    data.category === "language" &&
    data.subcategory === "korean"
);

const koreanPosts = posts.sort(
  (a, b) =>
    b.data.publishedDate.getTime() -
    a.data.publishedDate.getTime()
);

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="Korean｜ちっちゃな私には、ちっちゃな夢があります。"
  description="韓文入門、自學筆記與學習過程紀錄。"
>
  <main class="korean-page">

    <section class="page-hero">
      <div class="container">

        <nav
          class="breadcrumb"
          aria-label="麵包屑導覽"
        >
          <ol>
            <li>
              <a href={base}>HOME</a>
            </li>

            <li>
              <span aria-hidden="true">/</span>
              <a href={`${base}language/`}>
                LANGUAGE
              </a>
            </li>

            <li>
              <span aria-hidden="true">/</span>
              <span aria-current="page">
                KOREAN
              </span>
            </li>
          </ol>
        </nav>

        <p class="page-eyebrow">
          LANGUAGE / KOREAN
        </p>

        <h1>한국어 기록</h1>

        <p class="page-description">
          韓文入門、自學筆記、教材整理，以及慢慢累積下來的學習紀錄。
        </p>

      </div>
    </section>

    <section class="section">
      <div class="container">

        <div class="section-header">
          <div>
            <p class="section-eyebrow">
              STORIES
            </p>

            <h2>Korean Journal</h2>
          </div>

          <span class="post-count">
            {koreanPosts.length} STORIES
          </span>
        </div>

       <ArticleList
  posts={koreanPosts}
  categoryLabel="韓文學習"
  accent="var(--color-language)"
  emptyMessage="目前還沒有韓文文章。"
/>

      </div>
    </section>

  </main>
</Layout>

<style>
  .page-hero {
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    margin-bottom: var(--space-4);
  }

  .breadcrumb ol {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1);

    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .breadcrumb a {
    transition: color var(--transition-base);
  }

  .breadcrumb a:hover {
    color: var(--color-language);
  }

  .page-eyebrow,
  .section-eyebrow {
    margin-bottom: var(--space-1);

    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
  }

  .page-hero h1 {
    margin-bottom: var(--space-2);
  }

  .page-description {
    max-width: 560px;
    margin-bottom: 0;

    color: var(--color-text-muted);
  }

  .section-header {
    margin-bottom: var(--space-4);

    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .section-header h2 {
    margin-bottom: 0;
  }

  .post-count {
    color: var(--color-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }


  @media (max-width: 767px) {
    .page-hero {
      padding-block: var(--space-5);
    }

    .breadcrumb {
      margin-bottom: var(--space-3);
    }

    .section-header {
      align-items: start;
      flex-direction: column;
      gap: var(--space-1);
    }
  }
</style>
